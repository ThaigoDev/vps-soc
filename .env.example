# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32
SOC_DB_PASSWORD=
SOC_AGENT_TOKEN=
SOC_DASHBOARD_TOKEN=

# Where the dashboard/API listens on this machine (default: localhost only)
SOC_BIND=127.0.0.1
SOC_PORT=8088

# Telegram alerts (optional): create a bot with @BotFather, get chat id from @userinfobot
SOC_TELEGRAM_BOT_TOKEN=
SOC_TELEGRAM_CHAT_ID=
# LOW | MEDIUM | HIGH | CRITICAL
SOC_TELEGRAM_MIN_SEVERITY=HIGH

# Detection tuning
SOC_BRUTE_FORCE_THRESHOLD=10
SOC_EVENT_RETENTION_DAYS=30
# IPs whose SSH logins are expected and do not open root/new-source incidents
# (comma-separated). Hostinger's hPanel browser terminal uses 169.254.0.1.
SOC_TRUSTED_SSH_SOURCES=

# Active response: what the SOC asks the agent to do. AUTO | APPROVAL | OFF
SOC_RESPONSE_ENABLED=true
SOC_RESPONSE_BLOCK_BRUTE_FORCE=AUTO
SOC_RESPONSE_BLOCK_COMPROMISE=AUTO
SOC_RESPONSE_KILL_PROCESS=APPROVAL
SOC_RESPONSE_DISK_CLEANUP=AUTO
SOC_RESPONSE_RESTART_SERVICE=APPROVAL
# IPs/CIDRs that are never blocked (your home/office IP). Loopback, private ranges,
# Tailscale and link-local (hPanel terminal) are always protected.
SOC_RESPONSE_ALLOWLIST=
