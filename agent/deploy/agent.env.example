# /etc/vps-soc-agent/agent.env  (chmod 600, owned by root)

# Where the SOC backend listens. Prefer https, or a Tailscale/WireGuard address.
SOC_SERVER_URL=https://soc.example.com
# Must match SOC_AGENT_TOKEN in the backend .env
SOC_AGENT_TOKEN=change-me

# Optional
#SOC_HOST_ID=vps-01
#SOC_LOG_SOURCE=auto            # auto | journald | file
#SOC_AUTH_LOG_PATH=/var/log/auth.log
#SOC_HEARTBEAT_INTERVAL=30s
#SOC_PORT_SCAN_INTERVAL=30s
#SOC_FIM_INTERVAL=60s           # file integrity: passwd, sudoers, sshd_config, cron, authorized_keys
#SOC_PROCESS_SCAN_INTERVAL=15s  # suspicious processes: exe in /tmp or deleted, shells under web servers
# Only when the transport is already encrypted (e.g. http://100.x.y.z:8080 over Tailscale)
#SOC_ALLOW_INSECURE_HTTP=true

# --- Active response -------------------------------------------------------
# The agent only runs a fixed set of validated actions (block/unblock IP, kill a process it
# still classifies as malicious, journald/apt cleanup, restart a failed service). It never
# runs commands sent by the SOC. Set to false to make the agent detection-only.
#SOC_RESPONSE_ENABLED=true
# Extra IPs/CIDRs that must never be blocked (your home/office IP). Loopback, private
# ranges, Tailscale (100.64.0.0/10) and link-local (hPanel terminal) are always protected.
#SOC_RESPONSE_ALLOWLIST=203.0.113.10,198.51.100.0/24
# Local brute-force guard: works even with the SOC backend switched off.
#SOC_AUTOBLOCK=true
#SOC_AUTOBLOCK_THRESHOLD=10     # SSH failures from one IP...
#SOC_AUTOBLOCK_WINDOW=2m        # ...inside this window
#SOC_AUTOBLOCK_TTL=24h          # how long the block lasts (kernel timeout, survives agent restarts)
#SOC_ACTION_POLL_INTERVAL=5s    # how often the agent asks the SOC for approved actions

# PM2 apps (pm2 jlist as the daemon owner; nothing is written to PM2_HOME)
#SOC_PM2_INTERVAL=30s
