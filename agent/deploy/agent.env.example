# /etc/vps-soc-agent/agent.env  (chmod 600, owned by root)

# Where the SOC backend listens. Prefer https, or a Tailscale/WireGuard address.
SOC_SERVER_URL=https://soc.example.com
# Must match SOC_AGENT_TOKEN in the backend .env
SOC_AGENT_TOKEN=change-me

# Optional
#SOC_HOST_ID=vps-01
#SOC_LOG_SOURCE=auto            # auto | journald | file
#SOC_AUTH_LOG_PATH=/var/log/auth.log
#SOC_HEARTBEAT_INTERVAL=30s
#SOC_PORT_SCAN_INTERVAL=30s
#SOC_FIM_INTERVAL=60s           # file integrity: passwd, sudoers, sshd_config, cron, authorized_keys
#SOC_PROCESS_SCAN_INTERVAL=15s  # suspicious processes: exe in /tmp or deleted, shells under web servers
# Only when the transport is already encrypted (e.g. http://100.x.y.z:8080 over Tailscale)
#SOC_ALLOW_INSECURE_HTTP=true
