[Unit]
Description=VPS-SOC security agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/vps-soc-agent/agent.env
ExecStart=/usr/local/bin/vps-soc-agent
Restart=always
RestartSec=5

# Runs as root to read the journal, map sockets to processes in /proc/*/fd and run
# containment actions (nftables blocks, killing a malicious process), but everything else
# is locked down. Kernel module loading is allowed because nftables may need to load
# nf_tables modules the first time a block is created.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
# journal + apt cache: DISK_CLEANUP action (journalctl --vacuum-size, apt-get clean)
ReadWritePaths=/var/lib/vps-soc-agent -/var/log/journal -/var/cache/apt
StateDirectory=vps-soc-agent
StateDirectoryMode=0700
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=128M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
